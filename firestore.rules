/**
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model. All user-specific data is
 * stored in subcollections under that user's unique ID (`/users/{userId}`). This
 * ensures that a user can only ever access their own information. Anonymous access
 * to user data is completely blocked.
 *
 * Data Structure:
 * The data is organized into two main categories:
 * 1. Private User Data: All collections containing personal or sensitive information
 *    (profiles, quiz results, password checks) are nested under `/users/{userId}`.
 * 2. Public Content: Global, read-only content like quiz definitions and available
 *    badges are stored in top-level collections (`/quizzes`, `/badges`).
 *
 * Key Security Decisions:
 * - Default Deny: Access is denied by default. All permissions must be explicitly granted.
 * - Strict Ownership: The `isOwner()` function is the cornerstone of this ruleset,
 *   linking all access decisions for private data to the authenticated user's UID.
 * - No User Listing: It is not possible for any client to list all documents in
 *   the top-level `/users` collection, protecting user privacy.
 * - Immutable Ownership Links: For any document in a user's subcollection (e.g., a quiz
 *   result), the `userId` field is required on creation and is immutable upon update,
 *   preventing data from being reassigned to another user.
 * - Read-Only Public Data: Top-level content collections like `/quizzes` are publicly
 *   readable but are not writeable from the client-side. This ensures data integrity
 *   and prevents vandalism. This content must be managed via the Firebase Admin SDK.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for readable, reusable logic.
    
    /**
     * Checks if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the authenticated user's UID matches the provided userId.
     * This is the primary function for enforcing data ownership.
     * @param userId The user ID from the document path.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Ensures an operation is performed by the document owner and that the document
     * already exists. This is critical for safe update and delete operations.
     * @param userId The user ID from the document path.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * Validates that a new document contains a 'userId' field that correctly
     * matches the owner's UID from the path. This enforces relational integrity on create.
     * @param userId The user ID from the document path.
     */
    function isCreatingOwnData(userId) {
      return request.resource.data.userId == userId;
    }

    /**
     * Validates that an incoming user document has an 'id' field that matches
     * the user's UID. Specific to the root user document.
     * @param userId The user ID from the document path.
     */
    function isCreatingOwnUserDoc(userId) {
      return request.resource.data.id == userId;
    }

    /**
     * Ensures a critical, relational field (like 'userId' or 'id') cannot be changed
     * after the document has been created.
     * @param fieldName The name of the field to check for immutability.
     */
    function isOwnerFieldImmutable(fieldName) {
      return request.resource.data[fieldName] == resource.data[fieldName];
    }

    /**
     * @description Rules for the root user document.
     * @path /users/{userId}
     * @allow A newly signed-up user `user_abc` (create) their own document at `/users/user_abc`.
     * @deny An authenticated user `user_xyz` trying to (get) or (list) other user documents like `/users/user_abc`.
     * @principle Enforces Self-Creation and Ownership for a user's primary record, and prevents user enumeration.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // CRITICAL: Prevent listing all users in the application.
      allow create: if isOwner(userId) && isCreatingOwnUserDoc(userId);
      allow update: if isExistingOwner(userId) && isOwnerFieldImmutable('id');
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for a user's profile, which contains gamification stats.
     * @path /users/{userId}/profile/{profileId}
     * @allow User `user_abc` can (create) and (update) their own profile document.
     * @deny User `user_xyz` cannot (get) or (list) the profile of `user_abc`.
     * @principle Restricts access to a user's own data tree using path-based ownership.
     */
    match /users/{userId}/profile/{profileId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isCreatingOwnUserDoc(userId);
      allow update: if isExistingOwner(userId) && isOwnerFieldImmutable('id');
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for a user's individual quiz results.
     * @path /users/{userId}/quizResults/{quizResultId}
     * @allow User `user_abc` can (create) a new result and (list) their past results.
     * @deny User `user_xyz` cannot read, write, or delete the quiz results of `user_abc`.
     * @principle Validates relational integrity by ensuring the document's `userId` field matches the path on creation.
     */
    match /users/{userId}/quizResults/{quizResultId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isCreatingOwnData(userId);
      allow update: if isExistingOwner(userId) && isOwnerFieldImmutable('userId');
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for a user's password check history.
     * @path /users/{userId}/passwordChecks/{passwordCheckId}
     * @allow User `user_abc` can (create) a new password check record for their own account.
     * @deny Any other user attempting to access `user_abc`'s password check history.
     * @principle Enforces document ownership for writes and reads on sensitive, user-generated data.
     */
    match /users/{userId}/passwordChecks/{passwordCheckId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isCreatingOwnData(userId);
      allow update: if isExistingOwner(userId) && isOwnerFieldImmutable('userId');
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for emails a user is monitoring for breaches.
     * @path /users/{userId}/monitoredEmails/{monitoredEmailId}
     * @allow User `user_abc` can (create) and (delete) email monitoring entries for their account.
     * @deny Anonymous users cannot access any monitored email data.
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/monitoredEmails/{monitoredEmailId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isCreatingOwnData(userId);
      allow update: if isExistingOwner(userId) && isOwnerFieldImmutable('userId');
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for the list of badges a user has earned.
     * @path /users/{userId}/userBadges/{userBadgeId}
     * @allow User `user_abc` can (read) the list of badges they have earned.
     * @deny A user cannot grant themselves a badge; writes are disallowed for now.
     * @principle Restricts read access to the owner. Writes are blocked pending a server-side implementation for awarding badges.
     */
    match /users/{userId}/userBadges/{userBadgeId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isCreatingOwnData(userId);
      allow update: if isExistingOwner(userId) && isOwnerFieldImmutable('userId');
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for globally available quizzes.
     * @path /quizzes/{quizId}
     * @allow Any authenticated user can (get) or (list) the available quizzes to play.
     * @deny Any user attempting to (create), (update), or (delete) a quiz from the client.
     * @principle Protects the integrity of public, read-only content. It must be managed with the Admin SDK.
     */
    match /quizzes/{quizId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Rules for globally available quiz questions.
     * @path /questions/{questionId}
     * @allow Any authenticated user can (get) or (list) questions as part of taking a quiz.
     * @deny Any user attempting to modify questions from the client.
     * @principle Protects the integrity of public, read-only content.
     */
    match /questions/{questionId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Rules for globally available quiz options.
     * @path /options/{optionId}
     * @allow Any authenticated user can (get) or (list) options as part of taking a quiz.
     * @deny Any user attempting to modify options from the client.
     * @principle Protects the integrity of public, read-only content.
     */
    match /options/{optionId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Rules for globally available badges.
     * @path /badges/{badgeId}
     * @allow Any authenticated user can (get) or (list) all available badges in the application.
     * @deny Any user attempting to create or alter badge definitions from the client.
     * @principle Protects the integrity of public, read-only content.
     */
    match /badges/{badgeId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}